---
import SectionHeading from '../../components/SectionHeading.astro';
import type { Project } from '../../core/domain/project';

const { projects } = Astro.props as { projects: Project[] };
---

<section id="projects" class="mx-auto max-w-6xl px-6 py-20 md:py-28">
  <SectionHeading
    eyebrow="Proyectos"
    title="Repos curados, no un cementerio de demos"
    description="Selección mínima de trabajos que muestran criterio, consistencia visual y pensamiento técnico."
  />

  <div class="mt-12 grid gap-5 md:grid-cols-2 xl:grid-cols-3">
    {projects.map((project, index) => (
      <a
        href={project.href}
        class="reveal group block h-full rounded-[1.75rem] border border-white/10 bg-white/5 p-6 text-left backdrop-blur-xl transition duration-300 hover:-translate-y-2 hover:border-sky-300/30 hover:bg-white/10"
        style={`transition-delay: ${index * 50}ms`}
      >
        <div class="flex items-center justify-between gap-4">
          <span class="rounded-full border border-white/10 px-3 py-1 text-[11px] uppercase tracking-[0.25em] text-slate-300">
            {project.badge}
          </span>
          <span class="text-xs text-slate-400">★ {project.stars}</span>
        </div>

        <h3 class="mt-5 text-2xl text-white" style="font-family: var(--font-display);">{project.name}</h3>
        <p class="mt-3 text-sm leading-7 text-slate-300">{project.description}</p>

        <div class="mt-6 flex flex-wrap gap-2">
          {project.tags.map((tag) => (
            <span class="rounded-full bg-sky-400/10 px-3 py-1 text-xs text-sky-100">
              {tag}
            </span>
          ))}
        </div>
      </a>
    ))}
  </div>
</section>
