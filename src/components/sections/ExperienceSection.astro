---
import SectionHeading from '../../components/SectionHeading.astro';
import type { Experience } from '../../core/domain/experience';

const { experiences } = Astro.props as { experiences: Experience[] };
---

<section id="experience" class="mx-auto max-w-6xl px-6 py-20 md:py-28">
  <SectionHeading
    eyebrow="Experiencia"
    title="Impacto medible, no solo pantallas lindas"
    description="Cada rol prioriza performance, claridad de UX y estructuras de frontend que no se rompen cuando el producto crece."
  />

  <div class="mt-12 grid gap-5">
    {experiences.map((experience, index) => (
      <article 
        class="reveal rounded-[1.75rem] border border-white/10 bg-white/5 p-6 backdrop-blur-xl md:p-8"
        style={`transition-delay: ${index * 100}ms`}
      >
        <div class="flex flex-col gap-2 md:flex-row md:items-center md:justify-between">
          <div>
            <h3 class="text-2xl text-white" style="font-family: var(--font-display);">{experience.company}</h3>
            <p class="text-sm text-sky-200">{experience.role}</p>
          </div>
          <p class="text-sm text-slate-400">{experience.period}</p>
        </div>

        <p class="mt-4 max-w-3xl text-sm leading-7 text-slate-300 md:text-base">{experience.summary}</p>
        <div class="mt-5 flex flex-wrap gap-3">
          {experience.impact.map((item) => (
            <span class="rounded-full border border-white/10 bg-slate-900/50 px-4 py-2 text-xs text-slate-200">{item}</span>
          ))}
        </div>
      </article>
    ))}
  </div>
</section>
