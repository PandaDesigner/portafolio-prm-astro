---
import SectionHeading from '../../components/SectionHeading.astro';
import type { SkillGroup } from '../../core/domain/skill-group';

const { skills } = Astro.props as { skills: SkillGroup[] };
---

<section id="skills" class="mx-auto max-w-6xl px-6 py-20 md:py-28">
  <SectionHeading
    eyebrow="Skills"
    title="Stack moderno con criterio"
    description="Tecnología elegida para producir valor, no para coleccionar logos."
  />

  <div class="mt-12 grid gap-5 md:grid-cols-2">
    {skills.map((group, index) => (
      <article 
        class="reveal rounded-[1.75rem] border border-white/10 bg-white/5 p-6 backdrop-blur-xl"
        style={`transition-delay: ${index * 100}ms`}
      >
        <h3 class="text-xl text-white" style="font-family: var(--font-display);">{group.title}</h3>
        <div class="mt-5 flex flex-wrap gap-2.5">
          {group.items.map((item) => (
            <span class="rounded-full bg-white/10 px-4 py-2 text-sm text-slate-200 ring-1 ring-inset ring-white/10">{item}</span>
          ))}
        </div>
      </article>
    ))}
  </div>
</section>
