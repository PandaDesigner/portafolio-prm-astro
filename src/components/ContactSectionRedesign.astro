---
/**
 * ContactSection Component
 * Simple contact list with icons for the scrapbook theme.
 */
interface Props {
  contacts: Array<{
    label: string;
    href: string;
    kind: string;
  }>;
}

const { contacts } = Astro.props;
---

<div class="mt-12">
  <h2 class="text-3xl font-bold text-white mb-8" style="font-family: 'Playfair Display', serif;">
    Contact
  </h2>

  <div class="space-y-4">
    {contacts.map((contact) => (
      <a 
        href={contact.href}
        class="reveal flex items-center gap-4 group hover:translate-x-2 transition-transform duration-300"
      >
        <div class="w-10 h-10 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center group-hover:bg-sky-500/20 group-hover:border-sky-500/30 transition-colors">
          <!-- Temporary icon placeholder using Kind -->
          <span class="text-sky-300 text-xs font-bold">
            {(contact.kind || '??').substring(0, 2).toUpperCase()}
          </span>
        </div>
        <div>
          <span class="block text-xs uppercase tracking-widest text-slate-500 group-hover:text-sky-400 transition-colors font-bold">
            {contact.label}
          </span>
          <span class="block text-base text-slate-200 group-hover:text-white transition-colors">
            {contact.href.replace('mailto:', '').replace('https://', '')}
          </span>
        </div>
      </a>
    ))}
  </div>
</div>
