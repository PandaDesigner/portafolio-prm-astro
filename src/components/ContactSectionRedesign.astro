---
/**
 * ContactSection Component
 * Simple contact list with icons for the scrapbook theme.
 */
interface Props {
  contacts: Array<{
    label: string;
    href: string;
    kind: string;
  }>;
}

const { contacts } = Astro.props;
---

<div class="mt-12">
  <h2 class="text-3xl font-bold text-white mb-8" style="font-family: 'Playfair Display', serif;">
    Contact
  </h2>

  <div class="space-y-4 reveal-stagger">
    {contacts.map((contact) => (
      <a 
        href={contact.href}
        class="reveal flex items-center gap-4 group hover:translate-x-2 transition-transform duration-300"
      >
        <div class="w-10 h-10 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center group-hover:bg-sky-500/20 group-hover:border-sky-500/30 transition-all duration-500 text-sky-300 group-hover:text-sky-400 opacity-0 scale-50 group-[.visible]:opacity-100 group-[.visible]:scale-100">
          {contact.kind === 'email' && (
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
          )}
          {contact.kind === 'linkedin' && (
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg>
          )}
          {contact.kind === 'github' && (
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
          )}
          {(!['email', 'linkedin', 'github'].includes(contact.kind)) && (
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
          )}
        </div>
        <!-- Contenedor de textos con animaciones específicas -->
        <div class="flex flex-col">
          <!-- Título que sale deslizado desde el icono -->
          <div class="overflow-hidden">
            <span class="block text-xs uppercase tracking-widest text-slate-500 group-hover:text-sky-400 font-bold opacity-0 -translate-x-full group-[.visible]:opacity-100 group-[.visible]:translate-x-0 transition-all duration-500 delay-150">
              {contact.label}
            </span>
          </div>
          <!-- Texto que aparece desde arriba hacia abajo con fade -->
          <div class="overflow-hidden mt-0.5">
            <span class="block text-base text-slate-200 group-hover:text-white opacity-0 -translate-y-full group-[.visible]:opacity-100 group-[.visible]:translate-y-0 transition-all duration-500 delay-300">
              {contact.href.replace('mailto:', '').replace('https://', '')}
            </span>
          </div>
        </div>
      </a>
    ))}
  </div>
</div>
