---
interface Props {
  name: string;
  description: string;
  href: string;
  tags: string[];
}

const { name, description, href, tags } = Astro.props;

// Random rotation for manual look
const rotation = Math.floor(Math.random() * 4) - 2; // -2 to 2 degrees
---

<div class="reveal reveal-scale">
  <div 
    class="group relative bg-[#1a202c] p-6 shadow-xl transition-all duration-300 hover:-translate-y-2 hover:shadow-2xl"
    style={`transform: rotate(${rotation}deg);`}
  >
    <!-- Tape Effect -->
    <div class="absolute -top-3 left-1/2 -translate-x-1/2 w-20 h-8 bg-sky-200/10 backdrop-blur-md border border-white/10 -rotate-2 z-10 pointer-events-none"></div>

    <div class="space-y-4">
      <div class="flex items-start justify-between">
        <h3 class="text-2xl font-bold text-[#7ac5ff]" style="font-family: 'Playfair Display', serif;">
          {name}
        </h3>
        <a 
          href={href} 
          target="_blank" 
          rel="noopener noreferrer"
          class="text-sky-200/50 hover:text-sky-200 transition-colors"
          aria-label={`View ${name} on GitHub`}
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
        </a>
      </div>

      <p class="text-slate-400 text-sm leading-relaxed">
        {description}
      </p>

      <div class="flex flex-wrap gap-2">
        {tags.map(tag => (
          <span class="px-2 py-1 text-[10px] uppercase tracking-wider font-bold bg-[#7ac5ff]/5 text-[#7ac5ff]/70 border border-[#7ac5ff]/10 rounded">
            {tag}
          </span>
        ))}
      </div>
    </div>

    <!-- Notebook decoration dots -->
    <div class="absolute bottom-4 right-4 flex gap-1">
      <div class="w-1 h-1 rounded-full bg-sky-200/20"></div>
      <div class="w-1 h-1 rounded-full bg-sky-200/20"></div>
      <div class="w-1 h-1 rounded-full bg-sky-200/20"></div>
    </div>
  </div>
</div>

<style>
  .group::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle at 2px 2px, rgba(255,255,255,0.05) 1px, transparent 0);
    background-size: 24px 24px;
    pointer-events: none;
  }
</style>
