---
interface Props {
  name: string;
  description: string;
  href: string;
  tags: string[];
  lang?: 'es' | 'en';
}

const { name, description, href, tags, lang = 'es' } = Astro.props;

// Random rotation for manual look
const rotation = Math.floor(Math.random() * 4) - 2; // -2 to 2 degrees
---

<div class="reveal reveal-scale">
  <a 
    href={href}
    target="_blank"
    rel="noopener noreferrer"
    class="group block relative bg-[#1a202c] p-6 shadow-xl transition-all duration-300 hover:-translate-y-2 hover:shadow-2xl cursor-pointer"
    style={`transform: rotate(${rotation}deg);`}
    aria-label={`${lang === 'es' ? 'Ver proyecto' : 'View project'} ${name}`}
  >
    <!-- Tape Effect -->
    <div class="absolute -top-3 left-1/2 -translate-x-1/2 w-20 h-8 bg-sky-200/10 backdrop-blur-md border border-white/10 -rotate-2 z-10 pointer-events-none"></div>

    <div class="space-y-4">
      <div class="flex items-start justify-between">
        <h3 class="text-2xl font-bold text-[#7ac5ff] group-hover:text-[#5fb3f0] transition-colors" style="font-family: 'Playfair Display', serif;">
          {name}
        </h3>
        <span class="text-sky-200/50 group-hover:text-sky-200 transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
        </span>
      </div>

      <p class="text-slate-400 text-sm leading-relaxed">
        {description}
      </p>

      <div class="flex flex-wrap gap-2">
        {tags.map(tag => (
          <span class="px-2 py-1 text-[10px] uppercase tracking-wider font-bold bg-[#7ac5ff]/5 text-[#7ac5ff]/70 border border-[#7ac5ff]/10 rounded">
            {tag}
          </span>
        ))}
      </div>

      <!-- Ver proyecto button -->
      <div class="pt-2 flex items-center gap-2 text-[#7ac5ff] text-sm font-medium opacity-60 group-hover:opacity-100 transition-opacity">
        <span>{lang === 'es' ? 'Ver proyecto' : 'View project'}</span>
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="group-hover:translate-x-1 transition-transform"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </div>
    </div>

    <!-- Notebook decoration dots -->
    <div class="absolute bottom-4 right-4 flex gap-1">
      <div class="w-1 h-1 rounded-full bg-sky-200/20"></div>
      <div class="w-1 h-1 rounded-full bg-sky-200/20"></div>
      <div class="w-1 h-1 rounded-full bg-sky-200/20"></div>
    </div>
  </a>
</div>

<style>
  .group::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle at 2px 2px, rgba(255,255,255,0.05) 1px, transparent 0);
    background-size: 24px 24px;
    pointer-events: none;
  }
</style>
