---
import { Image } from 'astro:assets';
import type { Profile } from '@/core/domain/profile';
import { useTranslations } from '@/i18n/utils';

interface Props {
  profile: Profile;
  lang: 'es' | 'en';
}

const { profile, lang } = Astro.props;
const t = useTranslations(lang);
---

<header class="scrapbook-hero">
  <h1 class="sr-only">{profile.name} — {profile.role}</h1>
  <div class="hero-artwork">
    <Image
      src="/top-hero.png"
      alt=""
      width={1448}
      height={947}
      fetchpriority="high"
      class="original-artwork"
    />
    <!-- Preserve the original artwork; show the edited paper only behind the old subtitle. -->
    <Image
      src="/top-hero-subtitle-paper.png"
      alt=""
      width={1551}
      height={1014}
      class="subtitle-paper"
      aria-hidden="true"
    />
    <p class="hero-subtitle">{t('hero.role')}</p>
  </div>
</header>

<style>
  .scrapbook-hero {
    width: 100%;
    overflow: hidden;
    background: transparent;
    container-type: inline-size;
  }

  .hero-artwork { position: relative; width: 100%; }
  .original-artwork { display: block; width: 100%; height: auto; }
  .subtitle-paper {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    clip-path: inset(35% 39% 59% 29%);
    pointer-events: none;
  }
  .hero-subtitle {
    position: absolute;
    top: 36.1%;
    left: 28%;
    width: 34%;
    margin: 0;
    text-align: center;
    color: #171717;
    font-family: Arial, sans-serif;
    font-size: 1.22cqw;
    line-height: 1.25;
    white-space: nowrap;
  }
</style>
