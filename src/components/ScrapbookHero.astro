---
/**
 * ScrapbookHero Component
 * Full-width image header with a torn edge transition.
 */
---

<header class="relative w-full overflow-hidden bg-transparent">
  <div class="relative w-full flex justify-center">
    <img 
      src="/top-hero.png" 
      alt="Portfolio Scrapbook Header" 
      class="w-full h-auto block object-contain"
      width="1920"
      height="600"
    />
  </div>
</header>

<style>
  header {
    /* Ensure the hero doesn't have weird spacing at the bottom */
    font-size: 0;
  }
</style>
