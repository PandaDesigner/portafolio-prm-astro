---
/**
 * ProfilePolaroid Component
 * Display an image in a polaroid-style frame with a floating animation.
 */
---

<div class="profile-polaroid-container relative max-w-lg mx-auto lg:mx-0 opacity-0 translate-y-12">
  <div class="polaroid-frame relative transition-all duration-500 hover:scale-105">
    <div class="relative overflow-hidden flex items-center justify-center">
      <img 
        src="/img-prm.png" 
        alt="Profile Photo" 
        class="w-full h-auto object-contain"
      />
    </div>
  </div>
</div>

<script>
  import gsap from "gsap";
  import ScrollTrigger from "gsap/ScrollTrigger";
  
  gsap.registerPlugin(ScrollTrigger);

  function initPolaroid() {
    const container = document.querySelector('.profile-polaroid-container');
    if (!container) return;
    
    gsap.fromTo(container, 
      { opacity: 0, scale: 0.5, rotation: -15, y: 100 }, 
      { 
        opacity: 1, 
        scale: 1, 
        rotation: 0,
        y: 0,
        duration: 1, 
        ease: "back.out(1.5)",
        scrollTrigger: {
          trigger: container,
          start: "top 85%",
          toggleActions: "play reverse play reverse"
        }
      }
    );
  }

  document.addEventListener('astro:page-load', initPolaroid);
  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    initPolaroid();
  } else {
    document.addEventListener('DOMContentLoaded', initPolaroid);
  }
</script>

<style>
  .profile-polaroid-container {
    perspective: 1000px;
    will-change: transform, opacity;
  }

  .polaroid-frame {
    /* Mantenemos la rotación sutil y flotación constante por CSS después de que GSAP la posiciona */
    transform: rotate(-3deg);
    animation: floating 6s ease-in-out infinite;
  }

  @keyframes floating {
    0% {
      transform: rotate(-3deg) translateY(0px) translateX(0px);
    }
    50% {
      transform: rotate(-1deg) translateY(-15px) translateX(5px);
    }
    100% {
      transform: rotate(-3deg) translateY(0px) translateX(0px);
    }
  }

</style>
