---
/**
 * SoftwareGrid Component
 * Grid of software icons/badges with a handmade collage feel.
 */
interface Props {
  skills: Array<{
    title: string;
    items: string[];
  }>;
}

const { skills } = Astro.props;
---

<div class="mt-12">
  <h2 class="text-3xl font-bold text-white mb-8" style="font-family: 'Playfair Display', serif;">
    Software & Stack
  </h2>

  <div class="grid gap-6 sm:grid-cols-2">
    {skills.map((group) => (
      <div class="reveal collage-block p-6 rounded-2xl border border-white/10 bg-white/5 backdrop-blur-md relative overflow-hidden group">
        <!-- Abstract doodle decoration -->
        <div class="absolute -top-4 -right-4 w-12 h-12 border border-white/10 rounded-full group-hover:scale-150 transition-transform duration-700"></div>
        
        <h3 class="text-lg font-bold text-sky-200 mb-4">{group.title}</h3>
        <div class="flex flex-wrap gap-2">
          {group.items.map((item) => (
            <span class="px-4 py-2 rounded-lg bg-white/10 border border-white/5 text-sm text-slate-100 ring-1 ring-inset ring-white/5 hover:bg-white/20 transition-colors">
              {item}
            </span>
          ))}
        </div>
      </div>
    ))}
  </div>
</div>

<style>
  .collage-block {
    box-shadow: 
      inset 0 0 20px rgba(255, 255, 255, 0.02),
      5px 5px 15px rgba(0, 0, 0, 0.3);
  }
</style>
