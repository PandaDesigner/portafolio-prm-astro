---
const { eyebrow, title, description } = Astro.props;
---

<div class="max-w-3xl space-y-4">
  {eyebrow && <p class="text-xs font-semibold uppercase tracking-[0.28em] text-sky-300/80">{eyebrow}</p>}
  <h2 class="text-3xl leading-tight text-white md:text-5xl" style="font-family: var(--font-display);">{title}</h2>
  {description && <p class="max-w-2xl text-sm leading-7 text-slate-300 md:text-base">{description}</p>}
</div>
