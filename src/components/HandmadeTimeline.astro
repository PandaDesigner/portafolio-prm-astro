---
/**
 * HandmadeTimeline Component
 * A vertical timeline with a hand-drawn feel.
 */
interface Props {
  items: Array<{
    period: string;
    title: string;
    subtitle: string;
    description: string;
  }>;
  title: string;
}

const { items, title } = Astro.props;
---

<div class="timeline-container mt-10">
  <h2 class="text-3xl font-bold text-white mb-8" style="font-family: 'Playfair Display', serif;">
    {title}
  </h2>

  <div class="relative ml-4 pl-8 space-y-12 reveal-stagger">
    <!-- Static Background Track Line -->
    <div class="absolute left-0 top-0 bottom-0 w-[2px] bg-white/10"></div>
    
    <!-- GSAP Scroll-driven Dynamic Line -->
    <div class="gsap-timeline-line absolute left-0 top-0 bottom-0 w-[2px] bg-sky-400 origin-top scale-y-0 will-change-transform"></div>

    {items.map((item) => (
      <div class="timeline-item relative">
        <!-- Timeline dot (handmade look) -->
        <div class="timeline-dot absolute -left-[41px] top-1 w-5 h-5 rounded-full bg-white border-4 border-[#0d1220] ring-2 ring-white/10 scale-0 origin-center"></div>
        
        <div class="timeline-content flex flex-col">
          <!-- Fecha: sale desde el punto (horizontal) -->
          <div class="overflow-hidden">
            <span class="timeline-date block text-xs uppercase tracking-widest text-sky-400 font-bold opacity-0 -translate-x-full">{item.period}</span>
          </div>
          
          <!-- Texto: sale desde la fecha (vertical) -->
          <div class="overflow-hidden mt-1">
            <div class="timeline-body opacity-0 -translate-y-full">
              <h3 class="text-xl text-white font-semibold">{item.title}</h3>
              <p class="text-sm text-sky-200/80 mb-3">{item.subtitle}</p>
              <p class="text-base text-slate-400 leading-relaxed max-w-xl">{item.description}</p>
            </div>
          </div>
        </div>
      </div>
    ))}
  </div>
</div>

<style>
  .timeline-container {
    /* Subtle background grid pattern for paper feel */
    background-image: var(--paper-grid);
    background-size: 32px 32px;
  }
  
  /* Reveal inner dot when container is visible */
  .reveal.visible .scale-0 {
    transform: scale(1);
  }
</style>

<script>
  import gsap from "gsap";
  import ScrollTrigger from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  function initGsapTimeline() {
    const timelines = document.querySelectorAll('.timeline-container');
    
    timelines.forEach(container => {
      const line = container.querySelector('.gsap-timeline-line');
      if (!line) return;
      
      gsap.fromTo(line, 
        { scaleY: 0 },
        { 
          scaleY: 1, 
          ease: "none",
          scrollTrigger: {
            trigger: container,
            start: "top center", 
            end: "bottom center", 
            scrub: true 
          }
        }
      );

      // Animar cada punto y texto de la línea de tiempo
      const items = container.querySelectorAll('.timeline-item');
      items.forEach(item => {
        const dot = item.querySelector('.timeline-dot');
        const date = item.querySelector('.timeline-date');
        const body = item.querySelector('.timeline-body');
        
        const tl = gsap.timeline({
          scrollTrigger: {
            trigger: item,
            start: "top center", 
            end: "bottom center", 
            toggleActions: "play reverse play reverse",
            scrub: true 
          }
        });

        // 1. El punto hace "pop"
        tl.to(dot, { scale: 1, duration: 0.4, ease: "back.out(1.7)" })
          // 2. La fecha se desliza desde el punto hacia la derecha
          .to(date, { opacity: 1, x: 0, duration: 0.4, ease: "power2.out" })
          // 3. El contenido cae desde la fecha hacia abajo
          .to(body, { opacity: 1, y: 0, duration: 0.5, ease: "power2.out" });
      });
    });
  }

  document.addEventListener('astro:page-load', initGsapTimeline);
  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    initGsapTimeline();
  } else {
    document.addEventListener('DOMContentLoaded', initGsapTimeline);
  }
</script>
