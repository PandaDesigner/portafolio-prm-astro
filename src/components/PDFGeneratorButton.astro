---
interface Props {
  lang: 'es' | 'en';
}

const { lang } = Astro.props;

const buttonText = lang === 'es' ? 'Descargar PDF' : 'Download PDF';
const loadingText = lang === 'es' ? 'Generando...' : 'Generating...';
---

<button
  id="pdf-generator-btn"
  class="fixed bottom-6 right-6 z-50 flex items-center gap-2 px-5 py-3 bg-[#7ac5ff] text-slate-900 font-bold rounded-full shadow-lg hover:bg-[#5fb3f0] hover:scale-105 transition-all duration-300 group"
  aria-label={buttonText}
  data-text={buttonText}
  data-loading={loadingText}
>
  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="group-hover:animate-bounce">
    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
    <polyline points="7 10 12 15 17 10"/>
    <line x1="12" y1="15" x2="12" y2="3"/>
  </svg>
  <span id="pdf-btn-text">{buttonText}</span>
</button>

<script>
  import html2pdf from 'html2pdf.js';

  const btn = document.getElementById('pdf-generator-btn') as HTMLButtonElement | null;
  const btnText = document.getElementById('pdf-btn-text');
  
  if (btn && btnText) {
    btn.addEventListener('click', async () => {
      const currentLang = window.location.pathname.startsWith('/en') ? 'en' : 'es';
      const originalText = btn.dataset.text || (currentLang === 'en' ? 'Download PDF' : 'Descargar PDF');
      const loadingText = btn.dataset.loading || (currentLang === 'en' ? 'Generating...' : 'Generando...');
      
      btnText.textContent = loadingText;
      btn.disabled = true;
      btn.classList.add('opacity-75', 'cursor-not-allowed');
      
      try {
        const filename = currentLang === 'en' ? 'Pedro-Fernandez-Portfolio.pdf' : 'Pedro-Fernandez-Portafolio.pdf';
        const element = document.querySelector('main');
        
        if (!element) {
          throw new Error('Content not found');
        }

        // Crear clon para manipulación
        const wrapper = document.createElement('div');
        wrapper.style.position = 'absolute';
        wrapper.style.left = '-9999px';
        wrapper.style.width = '1200px';
        wrapper.style.backgroundColor = '#0f172a';
        document.body.appendChild(wrapper);

        const clone = element.cloneNode(true) as HTMLElement;
        clone.style.backgroundColor = '#0f172a';
        
        // Eliminar elementos con SVGs que puedan causar problemas con oklab
        const svgs = clone.querySelectorAll('svg');
        svgs.forEach(svg => {
          // Preservar el SVG pero asegurar que no tenga estilos problemáticos
          svg.style.fill = 'currentColor';
        });
        
        // Aplicar estilos inline conocidos y seguros
        const allElements = clone.querySelectorAll('*');
        const safeColors: Record<string, string> = {
          'bg-[#1a202c]': '#1a202c',
          'bg-[#7ac5ff]': '#7ac5ff',
          'bg-[#0f172a]': '#0f172a',
          'text-white': '#ffffff',
          'text-slate-300': '#cbd5e1',
          'text-slate-400': '#94a3b8',
          'text-sky-200': '#bae6fd',
          'text-[#7ac5ff]': '#7ac5ff',
          'border-[#7ac5ff]': '#7ac5ff',
        };
        
        allElements.forEach(el => {
          const htmlEl = el as HTMLElement;
          const classes = htmlEl.className.split(' ');
          classes.forEach(cls => {
            if (safeColors[cls]) {
              if (cls.startsWith('bg-')) htmlEl.style.backgroundColor = safeColors[cls];
              if (cls.startsWith('text-')) htmlEl.style.color = safeColors[cls];
              if (cls.startsWith('border-')) htmlEl.style.borderColor = safeColors[cls];
            }
          });
        });
        
        wrapper.appendChild(clone);
        
        // Configuración optimizada
        const opt = {
          margin: [10, 10, 10, 10] as [number, number, number, number],
          filename: filename,
          image: { type: 'jpeg' as const, quality: 0.95 },
          html2canvas: {
            scale: 1.5,
            useCORS: true,
            logging: false,
            letterRendering: true,
            backgroundColor: '#0f172a',
            removeContainer: true,
            foreignObjectRendering: false as boolean,
          },
          jsPDF: {
            unit: 'mm',
            format: 'a4',
            orientation: 'portrait' as const
          },
          pagebreak: {
            mode: ['css', 'legacy'] as const,
            avoid: ['img', 'svg', '.reveal']
          }
        };

        await html2pdf().set(opt).from(wrapper).save();
        
        // Limpieza
        document.body.removeChild(wrapper);
        
      } catch (error) {
        console.error('Error generating PDF:', error);
        alert(currentLang === 'en' ? 'Error generating PDF. Please try again.' : 'Error al generar el PDF. Inténtalo de nuevo.');
      } finally {
        btnText.textContent = originalText;
        btn.disabled = false;
        btn.classList.remove('opacity-75', 'cursor-not-allowed');
      }
    });
  }
</script>
