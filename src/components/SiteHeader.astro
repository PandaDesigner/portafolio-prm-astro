---
import LanguagePicker from './LanguagePicker.astro';
import DownloadButton from './DownloadButton.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const links = [
  [t('nav.hello'), '#hello'],
  [t('nav.experience'), '#experience'],
  [t('nav.projects'), '#projects'],
  [t('nav.contact'), '#contact'],
] as const;

const portraitSrc =
  '/enhanced_manos_en_los_bolsillos-_autoridad_relajada_un_retrato_editorial_cinematogrfico_hiperrealista_de_la__67xrrz909a5z5w1okvhc.png';
---

<header class="absolute top-0 left-0 right-0 z-30 border-b border-white/5 bg-transparent backdrop-blur-sm">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
    <a href="/" class="flex items-center gap-3 text-sm font-semibold text-[#0d121f]">
      <span class="relative grid h-10 w-10 overflow-hidden rounded-2xl border border-[#0d121f]/10 bg-[#0d121f]/5">
        <img
          src={portraitSrc}
          alt="Pedro Fernández"
          loading="eager"
          decoding="async"
          class="h-full w-full object-cover"
        />
        <span class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_top,rgba(13,18,31,0.16),transparent_55%)]" />
      </span>
      <span class="hidden sm:block">Pedro Fernández</span>
    </a>

    <div class="flex items-center gap-4">
      <nav class="hidden gap-6 text-sm text-[#0d121f]/90 md:flex">
        {links.map(([label, href]) => (
          <a class="transition hover:opacity-70 font-bold" href={href}>{label}</a>
        ))}
      </nav>
      <LanguagePicker />
        <DownloadButton />
    </div>
  </div>
</header>
