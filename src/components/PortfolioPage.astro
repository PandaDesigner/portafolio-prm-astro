---
import BaseLayout from '../layouts/BaseLayout.astro';
import ScrapbookHero from './ScrapbookHero.astro';
import ProfilePolaroid from './ProfilePolaroid.astro';
import HandmadeTimeline from './HandmadeTimeline.astro';
import ProjectCard from './ProjectCard.astro';
import SoftwareGrid from './SoftwareGrid.astro';
import ContactSectionRedesign from './ContactSectionRedesign.astro';
import SkillBar from './SkillBar.astro';
import { LocalPortfolioRepository } from '../core/infrastructure/local-portfolio-repository';
import { GitHubRepositoryAdapter } from '../core/infrastructure/github-repository-adapter';
import { BuildHomePageUseCase } from '../core/application/build-home-page';
import { useTranslations } from '../i18n/utils';

interface Props {
  lang: 'es' | 'en';
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const repository = new LocalPortfolioRepository(lang);
const github = new GitHubRepositoryAdapter('PandaDesigner', await repository.loadCuratedProjects());
const model = await new BuildHomePageUseCase(repository, github).execute();

const education = lang === 'en' ? [
  {
    period: '2019',
    title: 'UX/UI Design Certification',
    subtitle: 'Interaction Design Foundation',
    description: 'Specialization in user-centered design and advanced prototyping.'
  },
  {
    period: '2002 — 2008',
    title: 'Bachelor in Graphic Design',
    subtitle: 'UNICA - Cecilio Acosta Catholic University',
    description: 'Completed degree. Comprehensive training in visual communication, color theory, and editorial design.'
  },
  {
    period: '2000 — 2002',
    title: 'Computer Engineering',
    subtitle: 'URBE — Rafael Belloso Chacín University',
    description: 'Academic Base (50% Completed). Solid foundations in algorithms and computer architecture.'
  }
] : [
  {
    period: '2019',
    title: 'Certificación en Diseño UX/UI',
    subtitle: 'Interaction Design Foundation',
    description: 'Especialización en diseño centrado en el usuario y prototipado avanzado.'
  },
  {
    period: '2002 — 2008',
    title: 'Licenciatura en Diseño Gráfico',
    subtitle: 'UNICA - Universidad Católica Cecilio Acosta',
    description: 'Carrera culminada. Formación integral en comunicación visual, teoría del color y diseño editorial.'
  },
  {
    period: '2000 — 2002',
    title: 'Ingeniería en Computación',
    subtitle: 'URBE — Universidad Rafael Belloso Chacín',
    description: 'Base Académica (50% Completado). Fundamentos sólidos en algoritmos y arquitectura de computadores.'
  }
];

const technicalSkills = [
  { label: 'Frontend / UI Architecture', percentage: 100 },
  { label: 'UX / UI Design Systems', percentage: 100 },
  { label: `AI Tooling (Cursor, Antigravity, Claude)`, percentage: 100 },
  { label: `Advanced Coding (POO & Functional)`, percentage: 100 },
  { label: `Methodologies (SDD, TDD, Hexagonal)`, percentage: 100 },
  { label: 'Backend (Express/Next.js/NestJS)', percentage: 50 },
  { label: 'Python Development', percentage: 20 },
];
---

<BaseLayout title={`Portfolio | ${model.profile.name}`}>
  <ScrapbookHero />

  <main class="mx-auto max-w-7xl px-4 pb-24 md:px-8">
    <div class="grid gap-12 lg:grid-cols-[40%_60%] lg:items-start pt-12">
      
      <!-- Left Column: Visuals & Secondary Info -->
      <aside class="contents lg:block lg:space-y-16">
        <div class="flex justify-center lg:justify-start order-1">
          <ProfilePolaroid />
        </div>

        <div class="gsap-reveal order-4 lg:order-none">
          <HandmadeTimeline 
            title={lang === 'es' ? 'Educación' : 'Education'} 
            items={education} 
          />
        </div>

      </aside>

      <!-- Right Column: Primary Content -->
      <div class="contents lg:block lg:space-y-20">
        
        <!-- Hello Section -->
        <section id="hello" class="gsap-reveal gsap-reveal-right order-2">
          <h1 class="text-6xl font-bold text-white leading-tight" style="font-family: 'Playfair Display', serif;">
            {lang === 'es' ? '¡ Hola !' : 'Hello !'}
          </h1>
          <p class="mt-8 text-xl text-slate-300 leading-relaxed max-w-2xl">
            {model.profile.summary}
          </p>
          <p class="mt-4 text-lg text-sky-200/90 font-medium">
            {model.profile.role}
          </p>
        </section>

        <!-- Contact Section -->
        <section id="contact" class="gsap-reveal order-5">
          <ContactSectionRedesign contacts={model.contacts} />
        </section>

        <!-- Software Section -->
        <section id="software" class="order-6">
          <SoftwareGrid skills={model.skills} />
        </section>

        <!-- Experience Section -->
        <section id="experience" class="gsap-reveal order-7">
          <HandmadeTimeline 
            title={t('nav.experience')} 
            items={model.experiences.map(exp => ({
              period: exp.period,
              title: exp.company,
              subtitle: exp.role,
              description: exp.summary
            }))} 
          />
        </section>

        <!-- Technical Skills Section -->
        <section id="skills" class="gsap-reveal space-y-10 order-8">
          <div class="space-y-2">
            <h2 class="text-4xl font-bold text-white" style="font-family: 'Playfair Display', serif;">
              {lang === 'es' ? 'Habilidades Técnicas' : 'Technical Proficiency'}
            </h2>
            <div class="h-1 w-20 bg-[#7ac5ff] rounded-full"></div>
          </div>
          
          <div class="grid gap-x-12 gap-y-8 sm:grid-cols-2 reveal-stagger">
            {technicalSkills.map(skill => (
              <SkillBar label={skill.label} percentage={skill.percentage} />
            ))}
          </div>
        </section>

      </div>
    </div>
  </main>
</BaseLayout>

<script>
  import gsap from "gsap";
  import ScrollTrigger from "gsap/ScrollTrigger";
  
  gsap.registerPlugin(ScrollTrigger);

  function initGlobalReveals() {
    const reveals = document.querySelectorAll('.gsap-reveal');
    reveals.forEach(element => {
      // Configuramos el estado inicial antes de que GSAP lo tome para evitar FOUC
      const isRight = element.classList.contains('gsap-reveal-right');
      
      gsap.fromTo(element, 
        { 
          opacity: 0, 
          x: isRight ? 50 : 0,
          y: isRight ? 0 : 50
        }, 
        { 
          opacity: 1, 
          x: 0,
          y: 0,
          duration: 0.8, 
          ease: "power3.out",
          scrollTrigger: {
            trigger: element,
            start: "top 85%", // Cuando el top del elemento entra en el 85% del viewport
            toggleActions: "play reverse play reverse"
          }
        }
      );
    });
  }

  document.addEventListener('astro:page-load', initGlobalReveals);
  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    initGlobalReveals();
  } else {
    document.addEventListener('DOMContentLoaded', initGlobalReveals);
  }
</script>
