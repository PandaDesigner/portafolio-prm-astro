---
import BaseLayout from '../layouts/BaseLayout.astro';
import ScrapbookHero from './ScrapbookHero.astro';
import ProfilePolaroid from './ProfilePolaroid.astro';
import HandmadeTimeline from './HandmadeTimeline.astro';
import ProjectCard from './ProjectCard.astro';
import SoftwareGrid from './SoftwareGrid.astro';
import ContactSectionRedesign from './ContactSectionRedesign.astro';
import ProductProcessSection from './sections/ProductProcessSection.astro';
import { LocalPortfolioRepository } from '../core/infrastructure/local-portfolio-repository';
import { GitHubRepositoryAdapter } from '../core/infrastructure/github-repository-adapter';
import { BuildHomePageUseCase } from '../core/application/build-home-page';
import { useTranslations } from '../i18n/utils';

interface Props {
  lang: 'es' | 'en';
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const repository = new LocalPortfolioRepository(lang);
const github = new GitHubRepositoryAdapter('PandaDesigner', await repository.loadCuratedProjects());
const model = await new BuildHomePageUseCase(repository, github).execute();

const education = await repository.loadEducation();


---

<BaseLayout title={`${model.profile.name} | ${model.profile.role}`} description={model.profile.summary}>
  <ScrapbookHero profile={model.profile} lang={lang} />

  <div class="portfolio-main mx-auto max-w-7xl px-4 pb-24 md:px-8">
    <div class="grid gap-12 lg:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] lg:items-start pt-12">
      
      <!-- Left Column: Visuals & Secondary Info -->
      <aside class="contents lg:block lg:space-y-16">
        <div class="flex justify-center lg:justify-start order-1">
          <ProfilePolaroid />
        </div>

        <div class="gsap-reveal order-4 lg:order-none">
          <HandmadeTimeline 
            title={lang === 'es' ? 'Educación' : 'Education'} 
            items={education} 
          />
        </div>

        <!-- 3D Programmer Avatar (Full Height, Transparent Background) -->
        <div class="gsap-reveal-avatar order-8 lg:order-none relative w-full pt-12 lg:pt-0 hidden lg:block h-[800px]">
          <div class="absolute inset-0 w-full h-full rounded-3xl overflow-hidden shadow-[0_0_40px_rgba(14,165,233,0.15)] transition-transform duration-700 hover:scale-[1.02]">
            <img 
              src="/programmer-3d.png" 
              alt="3D Programmer Avatar" 
              class="w-full h-full object-cover"
              style="mix-blend-mode: screen; filter: contrast(1.2);"
            />
            <div class="absolute inset-0 rounded-3xl mix-blend-overlay border border-white/10"></div>
          </div>
        </div>
        
        <!-- Mobile fallback for 3D avatar -->
        <div class="gsap-reveal-avatar order-8 flex justify-center lg:hidden pt-12">
           <div class="relative w-full aspect-[9/16] rounded-3xl overflow-hidden shadow-[0_0_40px_rgba(14,165,233,0.15)]">
            <img 
              src="/programmer-3d.png" 
              alt="3D Programmer Avatar" 
              class="w-full h-full object-cover"
              style="mix-blend-mode: screen; filter: contrast(1.2);"
            />
          </div>
        </div>

      </aside>

      <!-- Right Column: Primary Content -->
      <div class="contents lg:block lg:space-y-20">
        
        <!-- Hello Section -->
        <section id="hello" class="gsap-reveal gsap-reveal-right order-2">
          <h2 class="text-3xl md:text-4xl font-bold text-white leading-tight" style="font-family: 'Playfair Display', serif;">
            {t('profile.title')}
          </h2>
          <p class="mt-8 text-xl text-slate-300 leading-relaxed max-w-2xl">
            {model.profile.summary}
          </p>
          <p class="mt-4 text-lg text-sky-200/90 font-medium">
            {model.profile.role}
          </p>
        </section>

        <!-- Contact Section -->
        <section id="contact" class="gsap-reveal order-5">
          <ContactSectionRedesign contacts={model.contacts} />
        </section>

        <!-- Software Section -->
        <section id="software" class="order-6 mt-12">
          <SoftwareGrid skills={model.skills} />
        </section>

        <!-- Experience Section -->
        <section id="experience" class="gsap-reveal order-7">
          <HandmadeTimeline 
            title={t('nav.experience')} 
            items={model.experiences.map(exp => ({
              period: exp.period,
              title: exp.company,
              subtitle: exp.role,
              description: exp.summary,
              impact: exp.impact
            }))} 
          />
        </section>

        <!-- Technical Skills Section -->
        <section id="skills" class="gsap-reveal space-y-10 order-8">
          <div class="space-y-2">
            <h2 class="text-4xl font-bold text-white" style="font-family: 'Playfair Display', serif;">
              {lang === 'es' ? 'Habilidades Técnicas' : 'Technical Proficiency'}
            </h2>
            <div class="h-1 w-20 bg-[#7ac5ff] rounded-full"></div>
          </div>
          
          <div class="grid gap-x-12 gap-y-8 sm:grid-cols-2 reveal-stagger">
            {model.skills.map(group => (
              <div>
                <h3 class="text-xl font-semibold text-white">{group.title}</h3>
                <p class="mt-3 text-base leading-relaxed text-slate-300">{group.items.join(' · ')}</p>
              </div>
            ))}
          </div>
        </section>

      </div>
    </div>

    <ProductProcessSection lang={lang} />

    <section id="github-projects" class="gsap-reveal mt-24 space-y-10" aria-labelledby="github-projects-title">
      <div class="space-y-3 text-center">
        <p class="text-sm font-bold uppercase tracking-[0.28em] text-sky-300">GitHub · @PandaDesigner</p>
        <h2 id="github-projects-title" class="text-4xl font-bold text-white md:text-5xl" style="font-family: 'Playfair Display', serif;">
          {lang === 'es' ? 'Repositorios destacados' : 'Featured repositories'}
        </h2>
        <p class="mx-auto max-w-2xl text-slate-300">
          {lang === 'es'
            ? 'Una selección actualizada de proyectos públicos, arquitectura frontend y experimentos de producto.'
            : 'An updated selection of public projects, frontend architecture work, and product experiments.'}
        </p>
      </div>

      <div class="grid gap-8 md:grid-cols-2 xl:grid-cols-3">
        {model.projects.map(project => (
          <ProjectCard
            name={project.name}
            description={project.description}
            href={project.href}
            tags={[...project.tags]}
            lang={lang}
          />
        ))}
      </div>

      <div class="text-center">
        <a
          href="https://github.com/PandaDesigner?tab=repositories"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-full border border-sky-300/40 px-6 py-3 font-semibold text-sky-200 transition hover:-translate-y-1 hover:border-sky-200 hover:bg-sky-300/10"
        >
          {lang === 'es' ? 'Ver todos los repositorios' : 'View all repositories'}
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .portfolio-main { overflow-x: clip; }
</style>

<script>
  import gsap from "gsap";
  import ScrollTrigger from "gsap/ScrollTrigger";
  
  gsap.registerPlugin(ScrollTrigger);

  function initGlobalReveals() {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const reveals = document.querySelectorAll('.gsap-reveal');
    reveals.forEach(element => {
      // Configuramos el estado inicial antes de que GSAP lo tome para evitar FOUC
      const isRight = element.classList.contains('gsap-reveal-right');
      
      gsap.fromTo(element, 
        { 
          opacity: 0, 
          x: isRight ? 50 : 0,
          y: isRight ? 0 : 50
        }, 
        { 
          opacity: 1, 
          x: 0,
          y: 0,
          duration: 0.8, 
          ease: "power3.out",
          scrollTrigger: {
            trigger: element,
            start: "top 85%", // Cuando el top del elemento entra en el 85% del viewport
            toggleActions: "play reverse play reverse"
          }
        }
      );
    });

    const avatars = document.querySelectorAll('.gsap-reveal-avatar');
    avatars.forEach(element => {
      gsap.fromTo(element, 
        { 
          opacity: 0, 
          scale: 0.8,
          y: 100
        }, 
        { 
          opacity: 1, 
          scale: 1,
          y: 0,
          duration: 1.2, 
          ease: "back.out(1.5)",
          scrollTrigger: {
            trigger: element,
            start: "top 85%",
            toggleActions: "play reverse play reverse"
          }
        }
      );
    });
  }

  document.addEventListener('astro:page-load', initGlobalReveals);
  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    initGlobalReveals();
  } else {
    document.addEventListener('DOMContentLoaded', initGlobalReveals);
  }
</script>
